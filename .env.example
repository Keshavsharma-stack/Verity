# Supabase Client Configuration
# Get these values from your Supabase Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server Admin Key (Server-Side Only - NEVER expose to frontend or prefix with VITE_)
# Required for background cron jobs and privileged operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Cron Endpoint Secret (Server-Side Only)
# Required to securely authenticate the /api/cron/process-expirations endpoint
# Generate a random secret (e.g., using `openssl rand -hex 32`)
CRON_SECRET=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (used for transactional email links).
APP_URL=

# Email Provider Configuration (Server-Side Only - NEVER expose to frontend or prefix with VITE_)
# Choose one of the following providers:
# 1. Resend (https://resend.com)
RESEND_API_KEY=

# 2. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=

# 3. Postmark (https://postmarkapp.com)
POSTMARK_API_KEY=

# 4. Custom SMTP Server
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Verified sender email address (e.g., "Verity Compliance <compliance@yourdomain.com>")
EMAIL_FROM=

# Stripe Billing Configuration (Server-Side Only - NEVER expose to frontend or prefix with VITE_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# Cashfree Billing Configuration (Server-Side Only - NEVER expose to frontend or prefix with VITE_)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
CASHFREE_PLAN_STARTER=
CASHFREE_PLAN_PRO=

