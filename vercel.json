{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/billing/:path*",
      "destination": "/api/billing?path=:path*"
    },
    {
      "source": "/api/webhooks/:path*",
      "destination": "/api/webhooks?path=:path*"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "/api/notifications?path=:path*"
    },
    {
      "source": "/api/reminders/:path*",
      "destination": "/api/reminders?path=:path*"
    },
    {
      "source": "/api/documents/:path*",
      "destination": "/api/documents?path=:path*"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/cron?path=:path*"
    },
    {
      "source": "/api/dev/:path*",
      "destination": "/api/cron?path=:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-expirations",
      "schedule": "0 0 * * *"
    }
  ]
}
